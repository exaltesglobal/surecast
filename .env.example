# Copy to .env for local development. On Hostinger, set these in
# Websites > app.surecast.live > Node.js > Environment variables. Never commit real values.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:5173

# A long random string (64+ chars). It signs sessions and encrypts channel credentials:
# changing it later disconnects every channel.
APP_SECRET=

# MySQL / MariaDB. On Hostinger use 127.0.0.1 (not the srvNNNN.hstgr.io host).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Sign-in codes and failure alerts. Hostinger mail: smtp.hostinger.com, port 465.
EMAIL_FROM="Surecast <alerts@surecast.live>"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Shared secret for the hPanel cron job that calls /v1/cron/tick every minute.
CRON_SECRET=

# Platforms that need a developer app. Leave blank to keep them switched off.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok Content Posting API (Login Kit + Direct Post). Google keys above also switch on YouTube.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# AI writing assistant (captions, rewrites, hashtags, alt text, brand voice).
# Get a key at console.anthropic.com. Leave blank to switch the assistant off.
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=300

# Surecast team: comma-separated emails that are always superadmins of /admin.
# Other staff are added from the admin panel's Staff tab.
ADMIN_EMAILS=

# Chitthi (WhatsApp) API base. Each agency pastes its own chk_live_ key in Settings.
CHITTHI_URL=https://app.chitthi.live
